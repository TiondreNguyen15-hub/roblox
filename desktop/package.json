{
  "name": "blue-main-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Black and blue desktop main menu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.robloxmenu.blue",
    "productName": "Blue Menu",
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "vendor/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "mac": {
      "target": "zip"
    }
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.18.0",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0"
  }
}
