{
  "name": "blue-main-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Authorized Roblox ESP and target-selection workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node session-controller.test.js && node target-selection.test.js && node local-backend.test.js && node game-process.test.js && node script-service.test.js",
    "test:session": "node session-controller.test.js"
  },
  "build": {
    "appId": "com.robloxmenu.blue",
    "productName": "Blue Menu",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "ui.js",
      "local-backend.js",
      "player-data.js",
      "game-profiles.js",
      "game-process.js",
      "session-controller.js",
      "target-selection.js",
      "visualization.js",
      "script-service.js",
      "lua-runner.js",
      "lua-highlight.js",
      "lua-editor.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "mac": {
      "target": "zip"
    },
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "lua-runner.js",
      "node_modules/**"
    ]
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "fengari": "0.1.5"
  }
}
