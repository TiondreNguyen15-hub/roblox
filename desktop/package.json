{
  "name": "blue-main-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Black and blue desktop main menu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node detector.test.js"
  },
  "build": {
    "appId": "com.robloxmenu.blue",
    "productName": "Blue Menu",
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "styles.css",
      "renderer.js",
      "vendor/ort*",
      "vendor/ONNX*",
      "models/**",
      "detector.js",
      "overlay.html",
      "overlay.js",
      "player-api.js",
      "player-data.js",
      "player-api-ui.js",
      "game-profiles.js",
      "game-process.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "mac": {
      "target": "zip"
    },
    "extraResources": [
      "track-window.ps1"
    ],
    "electronLanguages": [
      "en-US"
    ]
  },
  "devDependencies": {
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0",
    "electron": "40.10.6",
    "electron-builder": "26.18.0",
    "onnxruntime-web": "1.22.0"
  }
}
